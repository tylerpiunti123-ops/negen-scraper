# Postgres connection — set automatically when you add a Postgres database
# to this project in Vercel (Storage tab → Create Database → Postgres).
DATABASE_URL=

# Required to actually send emails (contact form notifications + follow-up sequence).
# Set EITHER the Gmail pair OR Resend — Gmail is tried first if both are set.

# Sends through your own Gmail account. Generate an App Password at
# myaccount.google.com/apppasswords (requires 2-Step Verification turned on).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alternative: sends through Resend instead of Gmail.
RESEND_API_KEY=

# Required for the admin dashboard to pull in Calendly bookings.
# Generate at: Calendly → Account settings → Integrations → API & Webhooks → Personal access tokens
CALENDLY_API_TOKEN=

# Password for the /admin dashboard. Pick anything.
ADMIN_PASSWORD=

# Optional — protects /api/cron/daily from being called by anyone else.
# If set, Vercel automatically sends it as a Bearer token when it fires the cron job.
CRON_SECRET=
