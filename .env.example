# Postgres connection — set automatically when you add a Postgres database
# to this project in Vercel (Storage tab → Create Database → Postgres).
DATABASE_URL=

# Required to actually send emails. Simplest option: Web3Forms, but it only
# covers contact-form notifications — the booking follow-up sequence (emails
# sent to leads) needs Gmail or Resend regardless.

# Simplest setup: go to web3forms.com, enter your email, it gives you an
# access key instantly. No account, no domain verification. Must use the
# NEXT_PUBLIC_ prefix — the contact form submits to Web3Forms directly from
# the visitor's browser (their spam protection blocks server-to-server
# submissions from cloud IPs like Vercel's).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Sends through your own Gmail account. Generate an App Password at
# myaccount.google.com/apppasswords (requires 2-Step Verification turned on).
# Covers both contact-form notifications and the booking follow-up sequence.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alternative to Gmail: sends through Resend instead.
RESEND_API_KEY=

# Required for the admin dashboard to pull in Calendly bookings.
# Generate at: Calendly → Account settings → Integrations → API & Webhooks → Personal access tokens
CALENDLY_API_TOKEN=

# Password for the /admin dashboard. Pick anything.
ADMIN_PASSWORD=

# Optional — protects /api/cron/daily from being called by anyone else.
# If set, Vercel automatically sends it as a Bearer token when it fires the cron job.
CRON_SECRET=
